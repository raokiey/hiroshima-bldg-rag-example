GEMINI_API_KEY=your_gemini_api_key

# --- Optional: override the default Hiroshima data paths ---
# Uncomment to point the pipeline and the running app at a different city's
# PLATEAU export. All are optional; unset ones fall back to the bundled
# Hiroshima sample data under data/.
# PLATEAU_GPKG_PATH=data/hiroshima_sample.gpkg
# PLATEAU_MAXLOD_GPKG_PATH=data/hiroshima_sample_maxlod.gpkg
# PLATEAU_LANDUSE_GPKG_PATH=data/hiroshima_landuse.gpkg
# PLATEAU_URF_GPKG_PATH=data/hiroshima_urf.gpkg
# PLATEAU_RELATED_DATA_DIR=data/related
# PLATEAU_CITY_PREFIX=34100_hiroshima-shi_city_2022
# PLATEAU_DB_PATH=output/plateau_rag.duckdb

# --- Optional: production deployment (Cloudflare Containers) ---
# Only needed if the frontend is ever served from a different origin than
# the API (normally both are served from the same FastAPI app, so CORS
# isn't required). Set to the deployed https://*.workers.dev or custom
# domain if that ever changes.
# PRODUCTION_ORIGIN=https://hiroshima-building-rag.<account>.workers.dev
